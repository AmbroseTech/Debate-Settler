# ============================================================================
# Debate_Settler (DS) — environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every secret lives here — nothing is hard-coded in the application.
# ============================================================================

# --- App ---
APP_NAME=Debate_Settler
APP_ENV=development                # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Database / cache ---
# Async URL is used by the app (asyncpg). Sync URL is used by Alembic (psycopg2).
DATABASE_URL=postgresql+asyncpg://ds:ds_password@localhost:5432/debate_settler
SYNC_DATABASE_URL=postgresql+psycopg2://ds:ds_password@localhost:5432/debate_settler
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Security ---
# Generate strong random values for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Compliance / feature flags ---
# Financially-sensitive features stay OFF until legally permitted and properly
# configured for the target jurisdiction. Do not enable blindly.
ENABLE_REAL_MONEY=false
ENABLE_LOCAL_MONEY=false
ENABLE_WITHDRAWALS=false
ENABLE_GAMES=true
REQUIRE_KYC=false
REQUIRE_AGE_VERIFICATION=false

# --- Financial configuration ---
DEFAULT_CURRENCY=UGX
# Platform settlement fee (percent). Business/legal may set it within MIN..MAX.
# Always disclosed to the user before any financial commitment.
PLATFORM_FEE_PERCENT=5.00
PLATFORM_FEE_MIN=0.00
PLATFORM_FEE_MAX=10.00
WITHDRAWAL_FEE_PERCENT=1.00
FUNDING_TIMEOUT_MINUTES=60

# --- Payment providers ---
# PAYMENT_MODE=demo simulates payments and clearly marks funds as DEMO.
# Use "live" only when real provider credentials are configured and verified.
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
MTN_API_KEY=
MTN_API_SECRET=
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
AIRTEL_API_KEY=
AIRTEL_API_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa

# --- Notifications ---
EMAIL_API_KEY=
EMAIL_FROM=no-reply@debate-settler.local
SMS_API_KEY=
