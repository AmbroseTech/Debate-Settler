# ============================================================================
# Debate Settler — environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every secret lives here — nothing is hard-coded in the application.
#
# Debate Settler is a FREE social debate platform. There are no payment
# providers, wallets, currencies, fees or any financial settings.
# ============================================================================

# --- App ---
APP_NAME=Debate Settler
APP_ENV=development                # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Database / cache ---
# Async URL is used by the app (asyncpg). Sync URL is used by Alembic (psycopg2).
DATABASE_URL=postgresql+asyncpg://ds:ds_password@localhost:5432/debate_settler
SYNC_DATABASE_URL=postgresql+psycopg2://ds:ds_password@localhost:5432/debate_settler
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Security ---
# Generate strong random values for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Platform features ---
ENABLE_GAMES=true
# Media upload limits (validated server-side; types are whitelisted in config).
MAX_MEDIA_UPLOAD_MB=25
MAX_VIDEO_SECONDS=120
MAX_IMAGE_UPLOAD_MB=8
MEDIA_ROOT=media

# --- Notifications ---
EMAIL_API_KEY=
EMAIL_FROM=no-reply@debate-settler.local
SMS_API_KEY=
